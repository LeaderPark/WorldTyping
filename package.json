{
  "name": "worldtyping",
  "private": true,
  "version": "0.0.0",
  "description": "WORLD TYPING (TypeTrip) monorepo root",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "build:data": "tsx tooling/scripts/build-data.ts",
    "build:moderation-snapshot": "tsx tooling/scripts/build-moderation-snapshot.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run && pnpm --filter @wt/api run test:workers",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "e2e": "pnpm --filter @wt/e2e run e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "lighthouse": "^13.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
