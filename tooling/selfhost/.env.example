# spec: WT-HOST-01 (Fable 5 승인, 리드 승인 완료) — Docker 자기호스팅 스택 환경 변수 템플릿.
#
# 사용법: 이 파일을 `tooling/selfhost/.env`로 복사한 뒤 아래 값을 채운다.
#   cp .env.example .env
# `.env`는 .gitignore/.dockerignore 대상이라 커밋되지 않는다 — 실값은 여기 이 파일(.example)에
# 절대 채우지 말 것.
#
# entrypoint.sh가 기동 시 이 값들을 검증한다: SESSION_HMAC_SECRET / RUN_HMAC_SECRET / DAILY_SALT
# 중 하나라도 비어 있거나 workers/api/.dev.vars의 로컬 전용 더미값(`dev-secret-*`)이면 컨테이너가
# 기동을 거부한다(exit 1) — 이 자기호스팅 인스턴스는 실제 공인 도메인에 노출되는 실배포이므로
# 세션/런 토큰 위조를 막기 위한 필수 게이트다.

# ---------------------------------------------------------------------------
# 시크릿 3종(필수) — docs/00 §7.3 시크릿 카탈로그, workers/api/src/env.ts와 동일 이름.
# 생성 예시(각각 독립적으로 한 번씩 실행해 서로 다른 값을 넣을 것):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_HMAC_SECRET=
RUN_HMAC_SECRET=
DAILY_SALT=

# ---------------------------------------------------------------------------
# 선택 필드
# ---------------------------------------------------------------------------
# 키 로테이션 중에만 채운다(구/신 2키 병행 검증, workers/api/src/mw/auth.ts). 로테이션 중이
# 아니면 비워둔다 — 값을 채우면서 dev-secret-* 더미를 넣으면 entrypoint.sh가 거부한다.
SESSION_HMAC_SECRET_PREV=

# Sentry DSN(toucan-js). 비워두면 lib/reporter.ts가 완전 no-op — 로컬/자기호스팅 초기엔
# 비워둬도 무방.
SENTRY_DSN=

# 공개 도메인. WT-HOST-02(cloudflared 터널)가 붙기 전까지도 채워둘 수 있다 — share-text.ts 등이
# 절대 URL 생성에 쓴다(비어 있으면 상대 경로로 폴백).
PUBLIC_ORIGIN=https://worldtyping.leaderpark.net
