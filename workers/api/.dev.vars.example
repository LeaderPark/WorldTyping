# spec: docs/00 §7.3(시크릿 카탈로그) + WT-M3-02 세션 환경 어댑테이션
# 로컬 wrangler dev 전용 시크릿 템플릿. 실제 값은 이 파일을 workers/api/.dev.vars로
# 복사해 채운다(.dev.vars는 .gitignore 대상 — 커밋 금지, 더미 값만 로컬에 둘 것).
# 프로덕션/스테이징 시크릿은 여기 두지 않는다 — `wrangler secret put --env <env>`로만 주입.

SESSION_HMAC_SECRET=dev-secret-session
# 로테이션 중이 아니면 비워둔다(선택 필드) — 값을 채우면 구/신 2키 병행 검증이 활성화된다.
SESSION_HMAC_SECRET_PREV=
RUN_HMAC_SECRET=dev-secret-run
DAILY_SALT=dev-secret-daily-salt

# GOOGLE_CLIENT_ID (WT-AUTH-01): Google GIS ID-token 검증의 aud 값. **공개값(시크릿 아님)** — 실값을
# 그대로 둔다. wrangler.toml [vars]에도 동일값이 있어(공개값이라 커밋됨) 로컬 wrangler dev는 이
# 항목이 없어도 동작하지만, .dev.vars를 쓰는 경우 [vars]를 덮어쓰므로 여기에 명시해 둔다.
GOOGLE_CLIENT_ID=615582111042-oq4vmmcnr5i2apap4d01b21a4laup3dj.apps.googleusercontent.com

# AE SQL API(선택, WT-M6-03 cron/retention.ts kpi_daily 스냅샷용). 계정 미연결 상태에서는
# 비워둔다 — 비어 있으면 해당 조회만 건너뛰고 D1 직접 계산 열만 채운다(스킵 로그로 확인).
# 실 발급 절차: Cloudflare 대시보드 → My Profile → API Tokens → "Account Analytics" 읽기 권한
# 토큰 생성 (Account.Account Analytics:Read).
CF_ACCOUNT_ID=
CF_AE_API_TOKEN=

# Sentry(toucan-js, WT-M6-04). 비워두면 lib/reporter.ts가 완전 no-op(예외 캡처 시도 자체를
# 하지 않는다) — 로컬 개발에는 값을 채울 필요 없다. 실 발급 절차: Sentry 프로젝트 생성 후
# Client Keys(DSN) 복사, prod/staging은 `wrangler secret put SENTRY_DSN --env <env>`로만 주입.
SENTRY_DSN=
