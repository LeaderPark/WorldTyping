{
  "name": "@wt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run -c vitest.workers.config.ts",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env prod"
  },
  "dependencies": {
    "hono": "^4.6.11",
    "@wt/shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
